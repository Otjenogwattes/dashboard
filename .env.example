# Kopieer naar .env (lokaal) en zet dezelfde waarden in Vercel onder
# Project > Settings > Environment Variables.
# Zonder deze twee draait Balkon in demo-modus met voorbeelddata.

# Supabase > Project Settings > API (of "Connect")
VITE_SUPABASE_URL=https://jouw-project.supabase.co
# De publishable key (sb_publishable_…) of de oude anon key. Deze mag in de browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Let op: de Spotify client secret en de service role key horen NIET hier.
# Die zet je als secrets in Supabase (zie supabase/functions/.env.example).
