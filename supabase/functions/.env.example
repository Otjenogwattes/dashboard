# Secrets voor de Edge Functions. Zet ze in Supabase onder
# Edge Functions > Secrets (of: npx supabase secrets set --env-file supabase/functions/.env).
# SUPABASE_URL en SUPABASE_SERVICE_ROLE_KEY zijn er standaard al.

# developer.spotify.com > Dashboard > jouw app > Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Adres van de app op Vercel (zonder / aan het eind). Meerdere? Scheid met komma's.
APP_URL=https://jouw-app.vercel.app

# Zelfbedacht lang wachtwoord; hetzelfde zet je in supabase/cron.sql.
CRON_SECRET=
